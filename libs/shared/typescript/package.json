{
  "name": "@opus-casino/shared",
  "version": "0.1.0",
  "description": "Shared libraries and utilities for Opus Casino platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "test": "jest",
    "proto:generate": "buf generate --template buf.gen.yaml --output src/proto"
  },
  "keywords": [
    "opus-casino",
    "gambling",
    "shared"
  ],
  "author": "Opus Casino Team",
  "license": "Proprietary",
  "dependencies": {
    "@grpc/grpc-js": "^1.9.0",
    "@protobuf-ts/runtime": "^2.9.0",
    "@protobuf-ts/runtime-rpc": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/opus-casino"
  }
}
