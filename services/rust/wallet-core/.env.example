# Wallet Core Service Configuration

# Application
APP__ENV=development
APP__NAME=wallet-core
APP__VERSION=0.1.0

# Database (PostgreSQL)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__DATABASE=opus_casino
DATABASE__USERNAME=postgres
DATABASE__PASSWORD=postgres
DATABASE__MAX_CONNECTIONS=20
DATABASE__MIN_CONNECTIONS=5
DATABASE__CONNECT_TIMEOUT_SECS=30
DATABASE__IDLE_TIMEOUT_SECS=600

# Redis (DragonflyDB)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__MAX_CONNECTIONS=10

# gRPC Server
GRPC__ADDR=0.0.0.0:50053
GRPC__MAX_MESSAGE_SIZE_MB=4

# HTTP Server (health, metrics, admin)
HTTP__ADDR=0.0.0.0:3003

# Metrics (Prometheus)
METRICS__ENABLED=true
METRICS__ADDR=0.0.0.0:9003

# Tracing (OpenTelemetry)
TRACING__ENABLED=true
TRACING__OTLP_ENDPOINT=http://localhost:4317
TRACING__SERVICE_NAME=wallet-core
