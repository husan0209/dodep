# RG Service — environment variables
# NEVER commit real secrets; use Vault / K8s Secrets in non-development.

# ── Server ──────────────────────────────────────────────��────────────────────
# HTTP 8091 / gRPC 50062 (next free pair after affiliate 8090/50061)
PORT=8091
GRPC_PORT=50062
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opus_casino?sslmode=disable

# ── Auth ─────────────────────────────────────────────────────────────────────
# Shared secret with auth-service (HS256 dev fallback). Production terminates
# user auth at the API gateway / auth-service ValidateToken.
JWT_SECRET_KEY=change-me-in-production
# Bearer token for /admin/rg/* (operator exclusions, apply-due).
# Fail-secure: when unset, every operator endpoint returns 403.
RG_ADMIN_TOKEN=

# ── Regulatory parameters ─────────────────────────────────────────────────────
# Cooling period before a limit INCREASE takes effect (24-72h, clamped).
RG_COOLING_HOURS=24
# Delay after a temporary exclusion expires before the player may revoke it.
RG_REVOKE_COOLING_HOURS=24