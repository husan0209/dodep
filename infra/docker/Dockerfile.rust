# Multi-stage Dockerfile for Rust services
# Opus Casino - Betting Engine, Wallet Core, WebSocket Gateway

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM rust:1.75-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    cmake \
    clang \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /build

# Copy Cargo manifests
COPY Cargo.toml Cargo.lock ./
COPY betting-engine/Cargo.toml ./betting-engine/Cargo.toml
COPY wallet-core/Cargo.toml ./wallet-core/Cargo.toml
COPY websocket-gateway/Cargo.toml ./websocket-gateway/Cargo.toml

# Create dummy src for caching
RUN mkdir -p betting-engine/src wallet-core/src websocket-gateway/src
RUN echo "fn main() {}" > betting-engine/src/main.rs
RUN echo "fn main() {}" > wallet-core/src/main.rs
RUN echo "fn main() {}" > websocket-gateway/src/main.rs

# Cache dependencies
RUN cargo fetch --locked

# Remove dummy src
RUN rm -rf betting-engine/src wallet-core/src websocket-gateway/src

# Copy source code
COPY . .

# Build the service (pass SERVICE_NAME as build arg)
ARG SERVICE_NAME=betting-engine
ARG PROFILE=release

# Build with optimizations
RUN cargo build --package ${SERVICE_NAME} --${PROFILE} --locked

# =============================================================================
# Stage 2: Runtime (distroless for security)
# =============================================================================
FROM gcr.io/distroless/cc-debian12 AS runtime

# Copy binary from builder
COPY --from=builder /build/target/${PROFILE:-release}/${SERVICE_NAME:-betting-engine} /usr/local/bin/app

# Set working directory
WORKDIR /

# Environment variables
ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

# Expose default port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/app", "--health-check"] || exit 1

# Run the application
ENTRYPOINT ["/usr/local/bin/app"]

# =============================================================================
# Stage 3: Debug (for development)
# =============================================================================
FROM rust:1.75-slim-bookworm AS debug

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

# Install debugging tools
RUN apt-get update && apt-get install -y \
    curl \
    netcat-openbsd \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy binary from builder (debug build)
COPY --from=builder /build/target/debug/${SERVICE_NAME:-betting-engine} /usr/local/bin/app

WORKDIR /

ENV RUST_LOG=debug
ENV RUST_BACKTRACE=full

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/app"]
