# Multi-stage Dockerfile for Rust services
# Opus Casino - Betting Engine, Wallet Core, WebSocket Gateway

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM rust:slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    zlib1g-dev \
    python3 \
    cmake \
    clang \
    protobuf-compiler \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src/services/rust

COPY libs/shared/rust /src/libs/shared/rust
COPY libs/proto /src/libs/proto
COPY libs/migrations /src/libs/migrations
COPY services/rust /src/services/rust

ARG SERVICE_NAME=betting-engine
ARG PROFILE=release

RUN cargo build --package ${SERVICE_NAME} --release

# =============================================================================
# Stage 2: Runtime
# =============================================================================
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

ARG SERVICE_NAME=betting-engine

COPY --from=builder /src/services/rust/target/release/${SERVICE_NAME} /usr/local/bin/app

WORKDIR /

ENV RUST_LOG=info
ENV RUST_BACKTRACE=1

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/app"]
