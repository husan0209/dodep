# Betting Engine Dockerfile
FROM rust:1.75-slim as builder

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

# Copy manifests
COPY Cargo.toml ./
COPY betting-engine/Cargo.toml ./betting-engine/

# Create dummy source for caching
RUN mkdir -p betting-engine/src && echo "fn main() {}" > betting-engine/src/main.rs

# Build dependencies (cached layer)
RUN cargo build --release --package betting-engine && rm -rf src/

# Copy actual source
COPY betting-engine/src ./betting-engine/src/

# Build application
RUN touch betting-engine/src/main.rs && cargo build --release --package betting-engine

# Runtime image (distroless)
FROM gcr.io/distroless/cc-debian12

COPY --from=builder /app/target/release/betting-engine /usr/bin/betting-engine

EXPOSE 8080

ENTRYPOINT ["/usr/bin/betting-engine"]
