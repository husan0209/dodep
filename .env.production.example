# ============================================================
# Opus Casino — Production Environment Template
# ============================================================
# Copy to `.env.production` and fill in real values.
# NEVER commit `.env.production` to git.
# ============================================================

# ---------- General ----------
APP_ENV=production
APP_DEBUG=false
APP_DOMAIN=casino.example.com
APP_BASE_URL=https://casino.example.com
PUBLIC_API_URL=https://casino.example.com/api

# ---------- PostgreSQL ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=opus_casino
POSTGRES_USER=opus_app
POSTGRES_PASSWORD=__CHANGE_ME_strong_random__
POSTGRES_SSL_MODE=disable
DATABASE_URL=postgresql://opus_app:__CHANGE_ME_strong_random__@postgres:5432/opus_casino?sslmode=disable

# ---------- DragonflyDB / Redis ----------
REDIS_HOST=dragonfly
REDIS_PORT=6379
REDIS_PASSWORD=__CHANGE_ME_redis_strong__
REDIS_URL=redis://:__CHANGE_ME_redis_strong__@dragonfly:6379/0

# ---------- ClickHouse ----------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=opus_casino
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=__CHANGE_ME_clickhouse_strong__
CLICKHOUSE_DSN=clickhouse://default:__CHANGE_ME_clickhouse_strong__@clickhouse:9000/opus_casino?secure=false

# ---------- Vault Transit ----------
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=__CHANGE_ME_vault_token__
VAULT_TRANSIT_KEY=admin-bff-totp

# ---------- Redpanda / Kafka ----------
REDPANDA_ENABLED=true
REDPANDA_BROKERS=redpanda:9092
KAFKA_BROKERS=redpanda:9092

# ---------- MinIO (S3-compatible) ----------
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=__CHANGE_ME_minio_user__
S3_SECRET_KEY=__CHANGE_ME_minio_secret__
S3_BUCKET=opus-casino
S3_REGION=us-east-1

# ---------- JWT / Auth ----------
# Generate Ed25519 keys with: openssl genpkey -algorithm ed25519 -out ed25519-priv.pem
# Then convert to base64: openssl pkey -in ed25519-priv.pem -pubout -outform DER | base64 -w 0
JWT_ED25519_PRIVATE_KEY=__CHANGE_ME_ed25519_private_base64__
JWT_ED25519_PUBLIC_KEY=__CHANGE_ME_ed25519_public_base64__
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800
PAYMENT_AUTH_ED25519_PUBLIC_KEY=__CHANGE_ME_ed25519_public_base64__
ADMIN_BFF_AUTH_ED25519_PUBLIC_KEY=__CHANGE_ME_ed25519_public_base64__

# ---------- Encryption (AES-256-GCM, 32 random bytes base64) ----------
ENCRYPTION_KEY=__CHANGE_ME_32_byte_base64_key__

# ============================================================
# NOWPayments (Crypto Payment Gateway)
# ============================================================
NOWPAYMENTS_API_KEY=S9ABM14-ZRW4V20-HS8C1SY-84MBY5P
NOWPAYMENTS_IPN_SECRET=cpWmw0u7X4m2hO5HrnXbZVzc+vcgoFBI
NOWPAYMENTS_API_URL=https://api.nowpayments.io
NOWPAYMENTS_IPN_CALLBACK_URL=https://casino.example.com/api/v1/payments/webhooks/nowpayments

# Payment service viper-style env (PAYMENT_NOWPAYMENTS_*)
PAYMENT_NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1
PAYMENT_NOWPAYMENTS_API_KEY=S9ABM14-ZRW4V20-HS8C1SY-84MBY5P
PAYMENT_NOWPAYMENTS_IPN_SECRET=cpWmw0u7X4m2hO5HrnXbZVzc+vcgoFBI
PAYMENT_NOWPAYMENTS_IPN_CALLBACK_URL=https://casino.example.com/api/v1/payments/webhooks/nowpayments

# ============================================================
# Casino Slot Providers
# ============================================================

# Pragmatic Play
# Docs: https://partners.pragmaticplay.com/api2/  (Seamless Wallet API v3)
PRAGMATIC_ENABLED=true
PRAGMATIC_AGENT_ID=__CHANGE_ME_secure_login__
PRAGMATIC_SECRET_KEY=__CHANGE_ME_pragmatic_secret__
PRAGMATIC_API_URL=https://api.prerelease-env.biz
PRAGMATIC_GAME_LAUNCH_URL=https://api.prerelease-env.biz/IntegrationService/v3/http/CasinoGameAPI/getCasinoGames/
PRAGMATIC_IP_ALLOWLIST=185.20.25.0/24,185.20.26.0/24
PRAGMATIC_REPLAY_WINDOW_SEC=180

# PG Soft (Pocket Games Soft)
# Docs: https://www.pgsoft.com/integration  (REST API + HMAC-SHA256)
PGSOFT_ENABLED=true
PGSOFT_OPERATOR_TOKEN=__CHANGE_ME_pgsoft_token__
PGSOFT_SECRET_KEY=__CHANGE_ME_pgsoft_secret__
PGSOFT_API_URL=https://api.pgsoft-games.com
PGSOFT_IP_ALLOWLIST=104.250.140.0/24,104.250.141.0/24
PGSOFT_REPLAY_WINDOW_SEC=180

# Amatic Industries
# Docs: Cashier API v2 + MD5 signature
AMATIC_ENABLED=true
AMATIC_OPERATOR_ID=__CHANGE_ME_amatic_op_id__
AMATIC_API_PASSWORD=__CHANGE_ME_amatic_password__
AMATIC_SECRET_KEY=__CHANGE_ME_amatic_secret__
AMATIC_API_URL=https://api.amatic-industries.com
AMATIC_IP_ALLOWLIST=212.87.0.0/24
AMATIC_REPLAY_WINDOW_SEC=180

# Amusnet (formerly EGT Interactive)
# Docs: https://amusnet.com/api  (REST + mTLS + HMAC-SHA256)
AMUSNET_ENABLED=true
AMUSNET_OPERATOR_ID=__CHANGE_ME_amusnet_op_id__
AMUSNET_SECRET_KEY=__CHANGE_ME_amusnet_secret__
AMUSNET_API_URL=https://api.amusnet.com
AMUSNET_CLIENT_CERT_PATH=/run/secrets/amusnet_client.crt
AMUSNET_CLIENT_KEY_PATH=/run/secrets/amusnet_client.key
AMUSNET_IP_ALLOWLIST=178.218.30.0/24
AMUSNET_REPLAY_WINDOW_SEC=180

# ============================================================
# Sportsbook (Sportradar Live Odds Feed)
# ============================================================
SPORTRADAR_API_KEY=__CHANGE_ME_sportradar_key__
SPORTRADAR_API_URL=https://api.sportradar.com
SPORTRADAR_LIVE_ODDS_WS=wss://oddsfeed.sportradar.com

# ============================================================
# KYC / Sumsub
# ============================================================
SUMSUB_API_KEY=__CHANGE_ME_sumsub_key__
SUMSUB_APP_TOKEN=__CHANGE_ME_sumsub_token__
SUMSUB_SECRET_KEY=__CHANGE_ME_sumsub_secret__
SUMSUB_API_URL=https://api.sumsub.com

# ============================================================
# Email (Notifications)
# ============================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=__CHANGE_ME_sendgrid_api_key__
SMTP_FROM_EMAIL=noreply@casino.example.com
SMTP_FROM_NAME=Opus Casino

# ============================================================
# Observability
# ============================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
SENTRY_DSN_BACKEND=__CHANGE_ME_sentry_backend_dsn__
SENTRY_DSN_FRONTEND=__CHANGE_ME_sentry_frontend_dsn__
SENTRY_ENVIRONMENT=production

# Prometheus / Grafana
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME_grafana_admin__
GRAFANA_DOMAIN=grafana.casino.example.com

# ============================================================
# Feature Flags
# ============================================================
FEATURE_2FA_ENABLED=true
FEATURE_KYC_ENABLED=true
FEATURE_CRYPTO_PAYMENTS=true
FEATURE_SPORTSBOOK_ENABLED=true
FEATURE_LIVE_CASINO_ENABLED=false
FEATURE_RESPONSIBLE_GAMBLING=true
FEATURE_GEO_BLOCKING=true

# ============================================================
# Rate Limiting (per IP, sliding window seconds)
# ============================================================
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_API_PER_MIN=100
RATE_LIMIT_DEPOSIT_PER_HOUR=20
RATE_LIMIT_WITHDRAW_PER_HOUR=10

# ============================================================
# Geo Blocking (ISO-3166 alpha-2 country codes)
# ============================================================
GEO_BLOCKED_COUNTRIES=US,UK,FR,IT,ES,NL,DE,RU,CN,IL,SY,IR,KP,CU
KYC_REQUIRED_COUNTRIES=DE,AT,CH,SE,NO,DK,FI,IS

# ============================================================
# Bonus Configuration
# ============================================================
WELCOME_BONUS_PERCENTAGE=100
WELCOME_BONUS_MAX_AMOUNT=200
WELCOME_BONUS_WAGERING_REQUIREMENT=30
WELCOME_BONUS_EXPIRY_DAYS=30

# ============================================================
# Backup
# ============================================================
BACKUP_S3_BUCKET=opus-casino-backups
BACKUP_RETENTION_DAYS=7
BACKUP_SCHEDULE_CRON="0 */6 * * *"
