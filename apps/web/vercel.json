{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "env": {
    "NEXT_PUBLIC_API_URL": {
      "type": "encrypted",
      "value": "https://api.opus-casino.com"
    },
    "NEXT_PUBLIC_WS_URL": {
      "type": "encrypted",
      "value": "wss://ws.opus-casino.com"
    }
  }
}
