# Keep the build context small and host-independent.
#
# Without this, a local `node_modules` (including Windows `.bin` shims that
# call node.exe) gets copied over the Linux dependencies installed in the
# deps stage, and the build dies with "node.exe: not found".

# Dependencies are installed inside the image by the deps stage.
node_modules

# Build output — regenerated by `npm run build` in the builder stage.
.next
out
next-env.d.ts

# Test and report artifacts
coverage
e2e/.auth
e2e/test-results
e2e/playwright-report
playwright-report
test-results

# Local env and editor state
.env
.env.*
!.env.example
*.log
npm-debug.log*
.DS_Store
.vscode
.idea

# VCS
.git
.gitignore