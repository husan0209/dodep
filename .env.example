# Environment variables template

# Copy this file to .env and fill in the values
# NEVER commit .env with real values

# ===========================================
# General
# ===========================================
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# ===========================================
# Database (PostgreSQL)
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=opus_casino
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# ===========================================
# Redis/Dragonfly
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# ===========================================
# ClickHouse
# ===========================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=opus_casino
CLICKHOUSE_DSN=clickhouse://default:changeme@localhost:9000/opus_casino?secure=false

# ===========================================
# Vault Transit
# ===========================================
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=changeme-vault-token
VAULT_TRANSIT_KEY=admin-bff-totp

# ===========================================
# Redpanda/Kafka
# ===========================================
REDPANDA_ENABLED=false
REDPANDA_BROKERS=localhost:9092

# ===========================================
# JWT
# ===========================================
JWT_SECRET_KEY=changeme-use-32-random-bytes
JWT_REFRESH_SECRET=changeme-use-32-random-bytes
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# ===========================================
# External APIs
# ===========================================
SUMSUB_API_KEY=changeme
SUMSUB_APP_TOKEN=changeme
STRIPE_SECRET_KEY=sk_test_changeme
SPORTRADAR_API_KEY=changeme

# ===========================================
# Encryption
# ===========================================
ENCRYPTION_KEY=changeme-use-32-random-bytes

# ===========================================
# Observability
# ===========================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_DSN=https://changeme@sentry.io/123456

# ===========================================
# Feature Flags
# ===========================================
FEATURE_2FA_ENABLED=true
FEATURE_KYC_ENABLED=false
FEATURE_CRYPTO_PAYMENTS=false
